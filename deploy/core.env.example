# core 環境變數範本 → 複製為 .env（勿提交實際值）
# 必填
CORE_GRPC_ADDR=100.64.0.2:50051
# LLM 分診 provider（OpenAI 相容協定，任何端點皆可：
#   OpenAI / DeepSeek / Groq / vLLM / Ollama / LM Studio...）
# 格式：name|base_url|model|api_key，逗號分隔多組即為備援鏈
# 範例：雲端為主、本地 Ollama 為備援
LLM_PROVIDERS=deepseek|https://api.deepseek.com/v1|deepseek-chat|sk-...,local|http://100.64.0.5:11434/v1|llama3|ollama
# 未設定 LLM_PROVIDERS 時以 FakeProvider 運行（離線/開發模式）
# 選填
SHADOW_MODE=1
TELEGRAM_BOT_TOKEN=
READAPI_URL=http://127.0.0.1:8090
